# Identity headers coming from the browser are dropped first, so the backend
# only ever sees what Authelia asserted (forward_auth sets them on success)
request_header -Remote-User
request_header -Remote-Groups
request_header -Remote-Email
request_header -Remote-Name

# Browser navigations without a session are redirected to the portal,
# XHR/fetch calls get 401 (the client reloads the page on 401)
forward_auth authelia:9091 {
	uri /api/authz/forward-auth
	copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
}
