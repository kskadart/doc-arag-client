NEXT_PUBLIC_API_URL=/api
NODE_ENV=production
DOMAIN=localhost
BACKEND_API_HOST=api
BACKEND_API_PORT=8103

# --- Authentication (Authelia behind Caddy forward_auth) -------------------
# Leave everything below unset for local development without a login.
# Enabling it needs a real domain with at least one dot (Authelia refuses
# `localhost` as a cookie domain) and authelia/users.yml (see users.example.yml).
# The backend must then run with AUTH_MODE=trusted-headers.
# AUTH_MODE=on
# COMPOSE_PROFILES=auth
# AUTHELIA_SESSION_SECRET=            # openssl rand -hex 32
# AUTHELIA_STORAGE_ENCRYPTION_KEY=    # openssl rand -hex 32
# AUTHELIA_JWT_SECRET=                # openssl rand -hex 32
# Only for a made-up local domain from /etc/hosts (self-signed certificates):
# CADDY_GLOBAL_OPTIONS=local_certs
